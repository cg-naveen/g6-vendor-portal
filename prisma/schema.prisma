generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VENDOR
}

enum VendorType {
  BUSINESS
  INDIVIDUAL
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum AccountType {
  BUSINESS
  FREELANCER
  CONTRACT_FREELANCER
}

enum BillStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum InvoiceTemplate {
  CLASSIC
  MODERN
  MINIMAL
  BOLD
}

enum SubmissionSource {
  VENDOR
  ADMIN
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  vendor      Vendor?
  resetTokens PasswordResetToken[]
}

model Vendor {
  id         String @id @default(cuid())
  userId     String @unique
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vendorCode String @unique

  type        VendorType
  status      VendorStatus @default(PENDING)
  accountType AccountType?

  // Common fields
  vendorEmail String
  phone       String
  country     String
  city        String
  state       String

  // Business fields
  companyName        String?
  companyRegNumber   String?
  businessAddress    String?
  contactPersonName  String?
  contactPersonEmail String?
  contactPersonPhone String?

  // Individual fields
  vendorName  String?

  // Individual home address (structured)
  homeAddressLine1 String?
  homeAddressLine2 String?
  homeCity         String?
  homePostcode     String?
  homeState        String?
  homeCountry      String?

  // Bank details
  bankName          String
  accountNumber     String
  accountHolderName String?
  ifsc              String?
  swift             String

  // Bank address (structured)
  bankAddressLine1 String?
  bankAddressLine2 String?
  bankCity         String?
  bankPostcode     String?
  bankState        String?
  bankCountry      String?

  // Invoice customization (Freelancer / Contract Freelancer)
  invoiceTemplate  InvoiceTemplate @default(CLASSIC)
  logoUrl          String?
  signatureUrl     String?
  watermarkText    String?
  footerText       String?
  invoiceSequence  Int             @default(0)

  // Contract terms / scope (Contract Freelancer) — rich text (HTML)
  contractInfo String? @db.Text

  // Recurring auto-billing (Contract Freelancer)
  autoBillingEnabled   Boolean   @default(false)
  recurringDescription String?
  recurringAmount      Decimal?  @db.Decimal(14, 2)
  billingDayOfMonth    Int?
  nextBillingDate      DateTime?
  lastBilledAt         DateTime?

  rejectionReason String?
  approvedAt      DateTime?
  createdByAdmin  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bills       Bill[]
  submissions InvoiceSubmission[]

  @@index([status])
  @@index([accountType])
}

model Bill {
  id          String     @id @default(cuid())
  vendorId    String
  vendor      Vendor     @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invoiceFile String
  fileName    String
  amount      Decimal    @db.Decimal(14, 2)
  description String?
  status      BillStatus @default(SUBMITTED)
  submittedAt DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  paymentStatus  PaymentStatus @default(UNPAID)
  amountPaid     Decimal?      @db.Decimal(14, 2)
  transactionFee Decimal?      @db.Decimal(14, 2)
  paidAt         DateTime?
  receiptNumber  String?       @unique
  receiptPath    String?

  @@index([vendorId])
}

model InvoiceSubmission {
  id            String           @id @default(cuid())
  vendorId      String
  vendor        Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  invoiceNumber String
  source        SubmissionSource
  template      InvoiceTemplate
  pdfPath       String?
  notes         String?
  isRecurring   Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  paymentStatus  PaymentStatus @default(UNPAID)
  amountPaid     Decimal?      @db.Decimal(14, 2)
  transactionFee Decimal?      @db.Decimal(14, 2)
  paidAt         DateTime?
  receiptNumber  String?       @unique
  receiptPath    String?

  lineItems TaskLineItem[]

  @@unique([vendorId, invoiceNumber])
  @@index([vendorId])
}

model TaskLineItem {
  id           String            @id @default(cuid())
  submissionId String
  submission   InvoiceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  date         DateTime
  description  String
  quantity     Decimal           @db.Decimal(10, 2)
  rate         Decimal           @db.Decimal(14, 2)
  amount       Decimal           @db.Decimal(14, 2)

  @@index([submissionId])
}

model OrgSettings {
  id          String   @id @default("singleton")
  companyName String   @default("G6 Labs Asia")
  address     String?
  taxId       String?
  email       String?
  phone       String?
  updatedAt   DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
